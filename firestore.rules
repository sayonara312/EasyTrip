rules_version = '2';

// Firestore Security Rules cho EasyTrip (TripSplit AI)
// Triển khai:  firebase deploy --only firestore:rules
//
// LƯU Ý QUAN TRỌNG:
// - App đăng nhập ẩn danh (anonymous auth). Phải bật provider "Anonymous"
//   trong Firebase Console -> Authentication -> Sign-in method trước khi deploy rules này.
// - Mỗi chuyến đi có ownerId + editors (danh sách uid được sửa).
// - Ai có id chuyến đi (và đã đăng nhập ẩn danh) cũng xem được qua link xem #trip=<id>, nhưng không liệt kê được chuyến của người khác.
// - Người có link sửa (#trip=<id>&key=<editKey>) tự thêm mình vào editors qua joinRequests.
// - Chuyến cũ (chưa có editors) chỉ sửa được sau khi có người "Nhận quyền sở hữu".

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isEditorOf(data) {
      return isSignedIn() && ('editors' in data) && request.auth.uid in data.editors;
    }

    function tripData(tripId) {
      return get(/databases/$(database)/documents/trips/$(tripId)).data;
    }

    function isValidTrip(data) {
      return data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && data.coverImage is string
        && data.coverImage.size() <= 1500000
        && data.members is list
        && data.members.size() <= 100
        && data.expenses is list
        && data.expenses.size() <= 2000
        && (!('advances' in data) || (data.advances is list && data.advances.size() <= 2000))
        && (!('ownerId' in data) || data.ownerId is string)
        && (!('editors' in data) || (data.editors is list && data.editors.size() <= 50));
    }

    // Thông tin ngân hàng của thành viên (để tạo QR chuyển khoản)
    function isValidBank(data) {
      return data.keys().hasOnly(['bin', 'bankName', 'accountNumber', 'accountName'])
        && data.bin is string && data.bin.matches('^[0-9]{6}$')
        && data.bankName is string && data.bankName.size() <= 40
        && data.accountNumber is string && data.accountNumber.matches('^[0-9]{4,19}$')
        && data.accountName is string && data.accountName.size() <= 50;
    }

    match /trips/{tripId} {
      // Xem một chuyến theo id (link chia sẻ). App luôn đăng nhập ẩn danh nên người có link vẫn xem được,
      // nhưng không gọi thẳng REST API mà không có tài khoản được.
      allow get: if isSignedIn();

      // Chỉ liệt kê được chuyến mình là editor (query where editors array-contains uid)
      allow list: if isSignedIn() && request.auth.uid in resource.data.editors;

      allow create: if isSignedIn()
        && isValidTrip(request.resource.data)
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.editors == [request.auth.uid];

      allow update: if isValidTrip(request.resource.data) && (
        // (a) editor sửa bình thường; không đổi chủ, chủ luôn nằm trong editors
        (isEditorOf(resource.data)
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.ownerId in request.resource.data.editors)
        // (b) nhận quyền sở hữu chuyến cũ chưa có chủ
        || (isSignedIn()
          && !('editors' in resource.data)
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.editors == [request.auth.uid])
        // (c) tham gia bằng link sửa: chỉ thêm chính mình vào editors, đã nộp đúng khóa
        || (isSignedIn()
          && ('editors' in resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['editors'])
          && request.resource.data.editors == resource.data.editors.concat([request.auth.uid])
          && exists(/databases/$(database)/documents/trips/$(tripId)/joinRequests/$(request.auth.uid)))
      );

      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      // Ảnh hóa đơn (data URL JPEG đã nén). Ai đọc được chuyến thì xem được ảnh; chỉ editor thêm/xóa.
      match /receipts/{receiptId} {
        allow get, list: if isSignedIn();
        allow create: if isEditorOf(tripData(tripId))
          && request.resource.data.keys().hasOnly(['expenseId', 'data', 'createdBy', 'createdAt'])
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.expenseId is string && request.resource.data.expenseId.size() <= 64
          && request.resource.data.createdAt is timestamp
          && request.resource.data.data is string
          && request.resource.data.data.size() <= 450000
          && request.resource.data.data.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$');
        allow delete: if isEditorOf(tripData(tripId));
      }

      // Số tài khoản ngân hàng: chỉ người có quyền sửa đọc/ghi được (người cầm link xem không thấy).
      match /bankAccounts/{memberId} {
        allow read, delete: if isEditorOf(tripData(tripId));
        allow create, update: if isEditorOf(tripData(tripId)) && isValidBank(request.resource.data);
      }

      // Bằng chứng người dùng có khóa sửa. Chỉ chủ chuyến liệt kê/xóa được (khi xóa chuyến).
      match /joinRequests/{uid} {
        allow list, delete: if isSignedIn() && tripData(tripId).ownerId == request.auth.uid;
        allow create, update: if isSignedIn()
          && uid == request.auth.uid
          && request.resource.data.key is string
          && request.resource.data.key == get(/databases/$(database)/documents/tripSecrets/$(tripId)).data.editKey;
      }
    }

    // Khóa sửa của từng chuyến. Chỉ editor đọc/tạo được; chỉ chủ xóa được (khi xóa chuyến).
    match /tripSecrets/{tripId} {
      allow get, create: if isEditorOf(tripData(tripId));
      allow delete: if isSignedIn() && tripData(tripId).ownerId == request.auth.uid;
    }

    // Chặn mọi truy cập khác theo mặc định
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
